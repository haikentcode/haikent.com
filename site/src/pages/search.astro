---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="PDF Scopy — Hitesh Regar"
  description="Full-text search across scanned UPSC topper answer-copies, indexed page by page."
>
  <main class="relative mx-auto flex min-h-screen max-w-[820px] flex-col px-6 py-10 sm:px-10 sm:py-14">
    <a
      href="/"
      data-magnetic
      class="reveal inline-flex w-fit items-center gap-2 self-start font-mono text-xs tracking-wide text-ink-muted transition-colors hover:text-cyan"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        class="h-3.5 w-3.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
      </svg>
      BACK TO OBSERVATION DECK
    </a>

    <div class="reveal mt-10 text-center" style="transition-delay: 60ms">
      <p class="font-mono text-xs tracking-[0.25em] text-amber">
        ARCHIVE · UPSC TOPPER COPIES
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl">
        PDF Scopy
      </h1>
      <p class="mx-auto mt-4 max-w-[520px] text-[1.05rem] leading-[1.75] text-ink-muted">
        Full-text search across scanned UPSC topper answer-copies — every
        page indexed and searchable, word by word.
      </p>
      <p class="mt-2 font-mono text-xs text-ink-muted/70">
        type in English or Hindi — "kitab" also finds किताब
      </p>
    </div>

    <form
      id="search-form"
      class="reveal glass-panel mx-auto mt-10 flex w-full max-w-[560px] gap-2 rounded-full p-1.5"
      style="transition-delay: 120ms"
    >
      <label for="search-input" class="sr-only">Search the archive</label>
      <input
        id="search-input"
        type="text"
        placeholder="Search the archive…"
        autocomplete="off"
        class="min-w-0 flex-1 rounded-full bg-transparent px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus-visible:outline-none"
      />
      <button
        type="submit"
        data-magnetic
        data-cursor="SCAN"
        class="shrink-0 rounded-full bg-gradient-to-r from-cyan to-violet px-6 py-2.5 text-sm font-semibold text-void shadow-[0_0_25px_rgba(34,211,238,0.3)] transition-transform hover:-translate-y-0.5"
      >
        Search
      </button>
    </form>

    <p
      id="search-status"
      class="reveal mt-4 text-center font-mono text-xs text-ink-muted"
      style="transition-delay: 160ms"
      role="status"
      aria-live="polite"
    >
    </p>

    <div id="search-results" class="mt-8 space-y-4"></div>
  </main>

  <div
    id="pdf-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-void/80 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="PDF page viewer"
  >
    <div class="glass-panel relative flex max-h-[90vh] w-full max-w-[720px] flex-col rounded-3xl p-4 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <p id="pdf-modal-title" class="min-w-0 truncate text-sm font-semibold text-ink"></p>
        <button
          id="pdf-modal-close"
          type="button"
          aria-label="Close viewer"
          class="grid h-8 w-8 shrink-0 place-items-center rounded-full text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
        >
          ✕
        </button>
      </div>

      <div class="relative mt-4 min-h-[300px] flex-1 overflow-auto rounded-xl border border-white/10 bg-void/60">
        <p
          id="pdf-modal-status"
          class="absolute inset-0 grid place-items-center px-6 text-center font-mono text-xs text-ink-muted"
        >
        </p>
        <canvas id="pdf-canvas" class="hidden max-w-full"></canvas>
      </div>

      <div class="mt-4 flex items-center justify-between gap-3">
        <button
          id="pdf-modal-prev"
          type="button"
          disabled
          class="glass-panel rounded-full px-4 py-2 text-xs font-semibold text-ink transition-opacity disabled:opacity-30"
        >
          ← Prev
        </button>
        <span id="pdf-modal-page" class="font-mono text-xs text-ink-muted"></span>
        <button
          id="pdf-modal-next"
          type="button"
          disabled
          class="glass-panel rounded-full px-4 py-2 text-xs font-semibold text-ink transition-opacity disabled:opacity-30"
        >
          Next →
        </button>
      </div>

      <a
        id="pdf-modal-download"
        href="#"
        target="_blank"
        rel="noopener"
        class="mt-3 text-center font-mono text-[0.65rem] text-ink-muted transition-colors hover:text-cyan"
      >
        Open original PDF in a new tab ↗
      </a>
    </div>
  </div>
</Layout>

<script>
  import Sanscript from "@indic-transliteration/sanscript";
  import { getDocument, GlobalWorkerOptions } from "pdfjs-dist";
  import pdfWorkerUrl from "pdfjs-dist/build/pdf.worker.min.mjs?url";

  GlobalWorkerOptions.workerSrc = pdfWorkerUrl;

  const DEVANAGARI = /[ऀ-ॿ]/;
  const LATIN_WORD = /^[a-zA-Z]+$/;

  // Casual romanized Hindi ("kitab") is vowel-length ambiguous against the
  // real spelling (किताब needs a long आ). Try every combination of
  // single/doubled vowel at each ambiguous position and keep whatever
  // Sanscript.js turns into valid-looking Devanagari, so the search casts a
  // wide net instead of requiring one "correct" romanization.
  function devanagariCandidates(word: string): string[] {
    if (!LATIN_WORD.test(word)) return [];

    const positions: number[] = [];
    for (let i = 0; i < word.length; i++) {
      const c = word[i].toLowerCase();
      if ("aiu".includes(c) && word[i + 1]?.toLowerCase() !== c) {
        positions.push(i);
      }
    }
    const capped = positions.slice(0, 4);

    const spellings = new Set<string>([word]);
    for (let mask = 1; mask < 1 << capped.length; mask++) {
      const chars = word.split("");
      capped.forEach((pos, bit) => {
        if (mask & (1 << bit)) chars[pos] += chars[pos];
      });
      spellings.add(chars.join(""));
    }

    const results = new Set<string>();
    for (const spelling of spellings) {
      try {
        const devanagari = Sanscript.t(spelling, "itrans", "devanagari").replace(/्$/, "");
        if (devanagari && devanagari !== spelling) results.add(devanagari);
      } catch {
        // ignore transliteration failures on unusual input
      }
    }
    return [...results];
  }

  function romanize(word: string): string | null {
    if (!DEVANAGARI.test(word)) return null;
    try {
      return Sanscript.t(word, "devanagari", "itrans") || null;
    } catch {
      return null;
    }
  }

  // Expands the typed query with cross-script candidates so "kitab" also
  // searches किताब, and किताब also searches kitAb, without needing the
  // user to know which script the archive stores a given page in.
  function expandQuery(raw: string): { query: string; terms: string[] } {
    const words = raw.trim().split(/\s+/).filter(Boolean);
    const extras = new Set<string>();

    for (const word of words) {
      if (extras.size >= 20) break;
      const roman = romanize(word);
      if (roman) {
        extras.add(roman);
        continue;
      }
      for (const candidate of devanagariCandidates(word)) {
        extras.add(candidate);
        if (extras.size >= 20) break;
      }
    }

    const terms = [...words, ...extras];
    return { query: terms.join(" "), terms };
  }

  const form = document.getElementById("search-form") as HTMLFormElement | null;
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const status = document.getElementById("search-status");
  const results = document.getElementById("search-results");

  type Result = {
    pdf_name: string;
    page_number: number;
    raw_text_data: string;
    score: number;
  };

  function escapeRegExp(text: string) {
    return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function escapeHtml(text: string) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  function highlight(text: string, words: string[]) {
    let safe = escapeHtml(text);
    for (const word of words) {
      if (!word) continue;
      const pattern = new RegExp(escapeRegExp(escapeHtml(word)), "gi");
      safe = safe.replace(
        pattern,
        (match) => `<mark class="rounded bg-cyan/25 text-cyan px-0.5">${match}</mark>`,
      );
    }
    return safe;
  }

  function renderResults(data: Result[], words: string[]) {
    if (!results || !status) return;
    results.innerHTML = "";

    if (data.length === 0) {
      status.textContent = "> no matches found";
      return;
    }

    status.textContent = `> ${data.length} match${data.length === 1 ? "" : "es"} found`;

    for (const item of data) {
      const card = document.createElement("div");
      card.className = "glass-panel rounded-3xl p-5";
      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-semibold text-ink break-all">${escapeHtml(item.pdf_name)}</h3>
          <div class="flex shrink-0 gap-2">
            <span class="rounded-full bg-violet/15 px-2.5 py-0.5 font-mono text-[0.65rem] text-violet">PAGE ${item.page_number}</span>
            <span class="rounded-full bg-cyan/15 px-2.5 py-0.5 font-mono text-[0.65rem] text-cyan">SCORE ${item.score}</span>
          </div>
        </div>
        <div class="mt-3 max-h-48 overflow-y-auto rounded-xl border border-white/10 bg-void/40 p-3 text-sm leading-[1.7] text-ink-muted">
          ${highlight(item.raw_text_data, words)}
        </div>
        <button
          type="button"
          class="view-pdf-btn mt-3 inline-flex items-center gap-1.5 font-mono text-xs text-amber transition-colors hover:text-cyan"
          data-pdf="${escapeHtml(item.pdf_name)}"
          data-page="${item.page_number}"
        >
          VIEW PAGE ${item.page_number} →
        </button>
      `;
      results.appendChild(card);
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !status || !results) return;

    const value = input.value.trim();
    if (!value) return;

    status.textContent = "> scanning archive…";
    results.innerHTML = "";

    try {
      const { query, terms } = expandQuery(value);
      const response = await fetch(`/search_api.php?query=${encodeURIComponent(query)}`);
      if (!response.ok) throw new Error("request failed");
      const data: Result[] = await response.json();
      renderResults(data, terms);
    } catch {
      status.textContent = "> transmission failed — try again";
    }
  });

  // PDF page viewer: renders the matched page directly from the archive
  // (hosted outside git under /static/media/pdf/, since the source PDFs
  // are far too large to check in) using pdfjs-dist's own range-request
  // support, so opening a single page doesn't fetch the whole file.
  const modal = document.getElementById("pdf-modal");
  const modalTitle = document.getElementById("pdf-modal-title");
  const modalStatus = document.getElementById("pdf-modal-status");
  const canvas = document.getElementById("pdf-canvas") as HTMLCanvasElement | null;
  const prevBtn = document.getElementById("pdf-modal-prev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("pdf-modal-next") as HTMLButtonElement | null;
  const pageLabel = document.getElementById("pdf-modal-page");
  const closeBtn = document.getElementById("pdf-modal-close");
  const downloadLink = document.getElementById("pdf-modal-download") as HTMLAnchorElement | null;

  let currentDoc: Awaited<ReturnType<typeof getDocument>["promise"]> | null = null;
  let currentPage = 1;
  let totalPages = 0;
  let renderToken = 0;

  function pdfUrl(name: string) {
    return `/static/media/pdf/${encodeURIComponent(name)}`;
  }

  function updatePageControls() {
    if (!pageLabel || !prevBtn || !nextBtn) return;
    pageLabel.textContent = `PAGE ${currentPage} / ${totalPages}`;
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
  }

  async function renderPage(pageNumber: number) {
    if (!currentDoc || !canvas || !modalStatus) return;
    const myToken = ++renderToken;
    canvas.classList.add("hidden");
    modalStatus.textContent = "> rendering page…";
    try {
      const page = await currentDoc.getPage(pageNumber);
      if (myToken !== renderToken) return;
      const viewport = page.getViewport({ scale: 1.4 });
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      await page.render({ canvasContext: ctx, viewport }).promise;
      if (myToken !== renderToken) return;
      canvas.classList.remove("hidden");
      modalStatus.textContent = "";
    } catch {
      if (myToken === renderToken) modalStatus.textContent = "> could not render this page";
    }
  }

  async function openViewer(pdfName: string, pageNumber: number) {
    if (!modal || !modalTitle || !modalStatus || !canvas || !downloadLink) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    modalTitle.textContent = pdfName;
    downloadLink.href = pdfUrl(pdfName);
    canvas.classList.add("hidden");
    modalStatus.textContent = "> opening archive file…";
    if (prevBtn) prevBtn.disabled = true;
    if (nextBtn) nextBtn.disabled = true;

    try {
      currentDoc = await getDocument({ url: pdfUrl(pdfName) }).promise;
      totalPages = currentDoc.numPages;
      currentPage = Math.min(Math.max(pageNumber, 1), totalPages);
      updatePageControls();
      await renderPage(currentPage);
    } catch {
      modalStatus.textContent = "> couldn't load this file — try opening it directly";
    }
  }

  function closeViewer() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    renderToken++;
    currentDoc = null;
  }

  closeBtn?.addEventListener("click", closeViewer);
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeViewer();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal && !modal.classList.contains("hidden")) closeViewer();
  });
  prevBtn?.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      updatePageControls();
      renderPage(currentPage);
    }
  });
  nextBtn?.addEventListener("click", () => {
    if (currentPage < totalPages) {
      currentPage++;
      updatePageControls();
      renderPage(currentPage);
    }
  });

  results?.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement)?.closest<HTMLElement>(".view-pdf-btn");
    if (!target) return;
    const pdfName = target.dataset.pdf;
    const page = Number(target.dataset.page ?? "1");
    if (pdfName) openViewer(pdfName, page);
  });
</script>
