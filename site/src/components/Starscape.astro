---
---

<div class="fixed inset-0 -z-10 overflow-hidden bg-void" aria-hidden="true">
  <canvas
    id="starfield"
    class="parallax-layer absolute inset-0 h-full w-full"
    data-depth="0.6"
  ></canvas>

  <!-- Nebula glows (drift animation lives on the inner div so the parallax
       transform on the wrapper doesn't fight the CSS animation for the
       same property) -->
  <div class="parallax-layer absolute inset-0" data-depth="3">
    <div
      class="animate-nebula absolute -top-40 -left-40 h-[600px] w-[600px] rounded-full bg-violet opacity-[0.2] blur-[110px]"
    >
    </div>
  </div>
  <div class="parallax-layer absolute inset-0" data-depth="4.5">
    <div
      class="animate-nebula absolute top-1/3 -right-32 h-[520px] w-[520px] rounded-full bg-cyan opacity-[0.18] blur-[110px]"
      style="animation-delay: -8s"
    >
    </div>
  </div>
  <div class="parallax-layer absolute inset-0" data-depth="2.4">
    <div
      class="animate-nebula absolute bottom-0 left-1/4 h-[420px] w-[420px] rounded-full bg-rose opacity-[0.14] blur-[110px]"
      style="animation-delay: -14s"
    >
    </div>
  </div>

  <!-- Planet limb, top-right -->
  <div
    class="parallax-layer absolute -top-[38vw] -right-[38vw] h-[70vw] w-[70vw] rounded-full sm:-top-[26vw] sm:-right-[26vw] sm:h-[50vw] sm:w-[50vw]"
    data-depth="1.6"
    style="background: radial-gradient(circle at 30% 30%, rgba(56,189,248,0.5) 0%, rgba(94,234,212,0.3) 30%, rgba(30,64,175,0.32) 48%, rgba(5,6,12,0) 74%); box-shadow: -60px 60px 220px 40px rgba(34,211,238,0.2);"
  >
  </div>

  <!-- Faint HUD grid -->
  <div
    class="parallax-layer absolute inset-0 opacity-[0.05]"
    data-depth="0.9"
    style="background-image: linear-gradient(rgba(148,190,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(148,190,255,0.5) 1px, transparent 1px); background-size: 64px 64px;"
  >
  </div>

  <!-- Scan-line sweep -->
  <div
    class="animate-scanline absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-cyan/0 via-cyan/[0.07] to-cyan/0"
  >
  </div>

  <!-- Vignette so foreground text always stays legible -->
  <div
    class="absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 0%, rgba(5,6,12,0) 0%, rgba(5,6,12,0.22) 65%, rgba(5,6,12,0.45) 100%);"
  >
  </div>
</div>

<script>
  const canvas = document.getElementById("starfield") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d") ?? null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  type Star = {
    x: number;
    y: number;
    radius: number;
    baseAlpha: number;
    speed: number;
    phase: number;
  };

  type Node = {
    x: number;
    y: number;
    vx: number;
    vy: number;
  };

  type Pulse = {
    from: Node;
    to: Node;
    t: number;
    speed: number;
  };

  let stars: Star[] = [];
  let nodes: Node[] = [];
  let pulses: Pulse[] = [];
  let width = 0;
  let height = 0;
  let lastResizeWidth = -1;
  const LINK_DISTANCE = 300;
  // Mobile browsers fire "resize" as the URL bar auto-hides/shows during
  // scroll, changing innerHeight but not innerWidth. Only rebuild the star
  // field when the width actually changes (a real rotation/resize), so
  // scrolling on mobile doesn't repeatedly reallocate every star/node.
  const isCoarsePointer = window.matchMedia("(pointer: coarse)").matches;

  function resize() {
    if (!canvas) return;
    if (isCoarsePointer && window.innerWidth === lastResizeWidth) {
      height = canvas.height = window.innerHeight;
      return;
    }
    lastResizeWidth = window.innerWidth;
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;

    const density = 7000;
    const count = Math.min(280, Math.floor((width * height) / density));
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      radius: Math.random() * 1.4 + 0.4,
      baseAlpha: Math.random() * 0.5 + 0.45,
      speed: Math.random() * 0.6 + 0.2,
      phase: Math.random() * Math.PI * 2,
    }));

    // A sparse, always-drifting node graph — an ambient nod to a neural net
    // quietly training in the background. Scales with viewport area, so it
    // naturally fills the wide empty margins on large desktop screens.
    // Skipped on mobile: its O(n^2) link check plus shadowBlur every frame
    // isn't worth the cost on a narrow viewport with no margins to fill.
    if (!isCoarsePointer) {
      const nodeCount = Math.min(46, Math.floor((width * height) / 42000));
      nodes = Array.from({ length: nodeCount }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.12,
      }));
      pulses = [];
    }
  }

  function drawNodeGraph() {
    if (!ctx) return;
    for (const node of nodes) {
      if (!reduceMotion) {
        node.x += node.vx;
        node.y += node.vy;
        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;
      }
    }

    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (dist < LINK_DISTANCE) {
          ctx.globalAlpha = (1 - dist / LINK_DISTANCE) * 0.4;
          ctx.strokeStyle = "#7dd3fc";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();

          if (!reduceMotion && Math.random() < 0.002 && pulses.length < 10) {
            pulses.push({ from: a, to: b, t: 0, speed: 0.006 + Math.random() * 0.01 });
          }
        }
      }
    }

    ctx.globalAlpha = 1;
    ctx.fillStyle = "#c7f9ff";
    ctx.shadowColor = "#22d3ee";
    ctx.shadowBlur = 12;
    for (const node of nodes) {
      ctx.beginPath();
      ctx.arc(node.x, node.y, 2.6, 0, Math.PI * 2);
      ctx.fill();
    }

    pulses = pulses.filter((pulse) => {
      pulse.t += pulse.speed;
      if (pulse.t >= 1) return false;
      const x = pulse.from.x + (pulse.to.x - pulse.from.x) * pulse.t;
      const y = pulse.from.y + (pulse.to.y - pulse.from.y) * pulse.t;
      ctx.globalAlpha = 1;
      ctx.fillStyle = "#67e8f9";
      ctx.shadowColor = "#67e8f9";
      ctx.shadowBlur = 14;
      ctx.beginPath();
      ctx.arc(x, y, 2.4, 0, Math.PI * 2);
      ctx.fill();
      return true;
    });

    ctx.shadowBlur = 0;
    ctx.globalAlpha = 1;
  }

  function draw(time: number) {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);
    for (const star of stars) {
      const twinkle = reduceMotion
        ? 1
        : 0.5 + 0.5 * Math.sin(time * 0.001 * star.speed + star.phase);
      ctx.globalAlpha = star.baseAlpha * twinkle;
      ctx.fillStyle = "#eaf2ff";
      ctx.beginPath();
      ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    if (!isCoarsePointer) drawNodeGraph();
    if (!reduceMotion) requestAnimationFrame(draw);
  }

  if (canvas && ctx) {
    resize();
    window.addEventListener("resize", resize);
    requestAnimationFrame(draw);
    if (reduceMotion) draw(0);
  }

  // Mouse-driven parallax: layers with a higher data-depth drift further.
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (canHover && !reduceMotion) {
    const layers = Array.from(
      document.querySelectorAll<HTMLElement>(".parallax-layer"),
    ).map((el) => ({ el, depth: Number(el.dataset.depth ?? 1) }));

    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;

    window.addEventListener("pointermove", (event) => {
      targetX = event.clientX / window.innerWidth - 0.5;
      targetY = event.clientY / window.innerHeight - 0.5;
    });

    function loop() {
      curX += (targetX - curX) * 0.06;
      curY += (targetY - curY) * 0.06;
      for (const { el, depth } of layers) {
        el.style.transform = `translate(${(-curX * depth * 14).toFixed(2)}px, ${(-curY * depth * 14).toFixed(2)}px)`;
      }
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  }
</script>
