---
interface Props {
  label: string;
  eyebrow: string;
  id?: string;
  color?: string;
}
const { label, eyebrow, id, color = "var(--color-cyan)" } = Astro.props;
---

<div id={id} class="reveal mb-10 scroll-mt-24 text-center">
  <p
    class="font-mono text-xs tracking-[0.25em]"
    style={`color: ${color}`}
  >
    {eyebrow}
  </p>
  <h2 class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
    {label}
  </h2>
  <div
    class="mx-auto mt-4 h-px w-16 rounded-full"
    style={`background: linear-gradient(90deg, transparent, ${color}, transparent)`}
  >
  </div>
</div>
