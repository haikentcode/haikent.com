<footer class="relative mt-8 border-t border-white/10 py-10">
  <div
    class="mx-auto flex max-w-[1100px] flex-col gap-6 px-6 sm:flex-row sm:items-center sm:justify-between sm:px-10"
  >
    <p class="font-mono text-xs text-ink-muted">
      © {new Date().getFullYear()} HITESH REGAR · TRANSMITTING FROM EARTH ORBIT
    </p>
    <div class="flex flex-wrap gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
            class="footer-icon glass-panel grid h-10 w-10 place-items-center rounded-full text-ink-muted transition-colors"
            style={`--icon-color: ${link.color}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4.5 w-4.5"
            >
              <path d={link.icon} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer-icon:hover {
    color: var(--icon-color);
    border-color: var(--icon-color);
  }
</style>
