---
const navLinks = [
  { href: "#about", label: "Crew Log" },
  { href: "#resume", label: "Mission Log" },
  { href: "#work", label: "Docking Bay" },
  { href: "#contact", label: "Transmission" },
];
---

<header class="fixed top-[2px] right-0 left-0 z-30">
  <div
    class="glass-panel mx-auto mt-4 flex max-w-[1100px] items-center justify-between rounded-full px-5 py-2.5 sm:mx-6 lg:mx-auto"
  >
    <a href="#top" class="flex items-center gap-2">
      <span
        class="grid h-8 w-8 place-items-center rounded-full bg-gradient-to-br from-cyan via-violet to-rose font-display text-sm font-bold text-void"
      >
        H
      </span>
      <span class="font-display text-sm font-semibold text-ink">
        Hitesh Regar
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link={link.href.slice(1)}
            class="rounded-full px-3.5 py-1.5 font-mono text-[0.7rem] tracking-wide text-ink-muted transition-colors hover:bg-white/5 hover:text-cyan aria-[current]:bg-white/5 aria-[current]:text-cyan"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <nav class="flex items-center gap-3 md:hidden">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-ink-muted">
            <span class="sr-only">{link.label}</span>
            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-current inline-block" />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.navLink ?? ""))
    .filter((el): el is HTMLElement => Boolean(el));

  function updateActive() {
    let currentId: string | undefined;
    for (const section of sections) {
      if (section.getBoundingClientRect().top < window.innerHeight * 0.4) {
        currentId = section.id;
      }
    }
    for (const link of navLinks) {
      if (link.dataset.navLink === currentId) {
        link.setAttribute("aria-current", "true");
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateActive();
      ticking = false;
    });
  }

  updateActive();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
