---
import { Image } from "astro:assets";
import SectionMark from "./SectionMark.astro";
import lsrsImage from "../assets/portfolio-1.jpg";
import guitarImage from "../assets/portfolio-2.jpg";
import pianoImage from "../assets/portfolio-3.jpg";

const categoryColors: Record<string, string> = {
  IT: "var(--color-cyan)",
  Music: "var(--color-rose)",
};

const items = [
  {
    title: "lsrs.in",
    category: "IT",
    range: "",
    description:
      "Wholesale marketplace for women's apparel, designed and hosted end to end.",
    tags: ["Python", "Django", "Bootstrap", "DRF"],
    link: "http://lsrs.in/",
    image: lsrsImage,
  },
  {
    title: "haikent.com",
    category: "IT",
    range: "",
    description: "This site — personal CV, designed and hosted by me.",
    tags: ["PHP", "Astro", "Tailwind CSS"],
    link: null,
    image: null,
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9Z"/>',
  },
  {
    title: "digitalEye",
    category: "IT",
    range: "2016",
    description:
      "Automated attendance management system using face recognition.",
    tags: ["Python", "OpenCV"],
    link: "https://github.com/haikentcode/digitalEye",
    image: null,
    icon: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  },
  {
    title: "Snake Game and other",
    category: "IT",
    range: "2014",
    description: "A handful of small games built in C++ during college.",
    tags: ["C++"],
    link: "https://github.com/haikentcode/codeislife",
    image: null,
    icon: '<rect x="2" y="7" width="20" height="10" rx="5"/><path d="M7 10v4M5 12h4M16.5 10.5h.01M19 12.5h.01"/>',
  },
  {
    title: "Angie",
    category: "IT",
    range: "2020 — present",
    description: "Arduino and sensor-based self-driving toy car.",
    tags: ["Arduino", "IoT"],
    link: null,
    image: null,
    icon: '<path d="M4 16l1.1-4.4A2 2 0 0 1 7 10h10a2 2 0 0 1 1.9 1.6L20 16"/><path d="M3 16h18"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/>',
  },
  {
    title: "Image & text classification",
    category: "IT",
    range: "2018 — present",
    description:
      "Classifying text and images with Keras, FastText, and StarSpace.",
    tags: ["Keras", "FastText", "StarSpace"],
    link: null,
    image: null,
    icon: '<path d="M4 8V5a1 1 0 0 1 1-1h3M20 8V5a1 1 0 0 0-1-1h-3M4 16v3a1 1 0 0 0 1 1h3M20 16v3a1 1 0 0 1-1 1h-3"/><rect x="8" y="8" width="8" height="8" rx="1"/>',
  },
  {
    title: "Guitar",
    category: "Music",
    range: "",
    description: "An acoustic cover.",
    tags: [],
    link: "https://www.youtube.com/watch?v=r44nr4Hsg78",
    image: guitarImage,
  },
  {
    title: "Piano",
    category: "Music",
    range: "",
    description: "Beethoven's Ode to Joy, Symphony No. 9.",
    tags: [],
    link: "https://www.youtube.com/watch?v=6DobjdM8Mrg",
    image: pianoImage,
  },
];

const filters = ["All", "IT", "Music"];
---

<section class="relative mx-auto flex min-h-screen max-w-[1100px] flex-col justify-center px-6 py-24">
  <SectionMark label="Docking Bay" eyebrow="WORK" id="work" color="var(--color-cyan)" />

  <div
    class="reveal mb-8 flex justify-center gap-2"
    role="group"
    aria-label="Filter work by category"
  >
    {
      filters.map((filter, i) => (
        <button
          type="button"
          data-filter={filter}
          class:list={[
            "work-filter rounded-full px-4 py-1.5 font-mono text-xs tracking-wide transition-colors",
            i === 0
              ? "is-active bg-cyan text-void"
              : "glass-panel text-ink-muted hover:text-ink",
          ]}
        >
          {filter}
        </button>
      ))
    }
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => {
        const color = categoryColors[item.category];
        const Wrapper = item.link ? "a" : "div";
        return (
          <div class="work-row reveal" data-category={item.category}>
            <Wrapper
              href={item.link ?? undefined}
              target={item.link ? "_blank" : undefined}
              rel={item.link ? "noopener" : undefined}
              data-cursor={item.link ? "VIEW" : undefined}
              class="tilt-card glass-panel group block h-full overflow-hidden rounded-3xl transition-shadow"
              style={`--glow: ${color}`}
            >
              <div class="relative h-40 w-full overflow-hidden">
                {item.image ? (
                  <>
                    <Image
                      src={item.image}
                      alt={item.title}
                      width={480}
                      height={320}
                      class="h-full w-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-void/70 via-void/10 to-transparent" />
                  </>
                ) : (
                  <div
                    class="relative flex h-full w-full items-center justify-center overflow-hidden"
                    style={`background: color-mix(in srgb, ${color} 9%, #05060c)`}
                  >
                    <div
                      class="absolute inset-0 opacity-40"
                      style={`background-image: radial-gradient(color-mix(in srgb, ${color} 55%, transparent) 1px, transparent 1.5px); background-size: 16px 16px;`}
                    >
                    </div>
                    <div
                      class="absolute h-24 w-24 rounded-full blur-2xl"
                      style={`background-color: color-mix(in srgb, ${color} 35%, transparent)`}
                    >
                    </div>
                    <span
                      class="relative grid h-14 w-14 place-items-center rounded-full border"
                      style={`border-color: color-mix(in srgb, ${color} 40%, transparent); background-color: color-mix(in srgb, #05060c 60%, transparent)`}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke={color}
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-6 w-6"
                        set:html={item.icon}
                      />
                    </span>
                  </div>
                )}
              </div>
              <div class="p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-base font-semibold text-ink">
                    {item.title}
                  </h3>
                  <span
                    class="rounded-full px-2.5 py-0.5 font-mono text-[0.65rem]"
                    style={`background-color: color-mix(in srgb, ${color} 15%, transparent); color: ${color}`}
                  >
                    {item.category}
                  </span>
                </div>
                <p class="mt-2 text-sm leading-[1.6] text-ink-muted">
                  {item.description}
                </p>
                {item.tags.length > 0 && (
                  <p class="mt-3 text-xs text-ink-muted">
                    {item.tags.join(" · ")}
                  </p>
                )}
                {item.range && (
                  <p class="mt-2 font-mono text-xs text-ink-muted">
                    {item.range}
                  </p>
                )}
              </div>
            </Wrapper>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .tilt-card {
    will-change: transform;
  }
  .tilt-card:hover {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--glow) 40%, transparent),
      0 20px 60px -20px color-mix(in srgb, var(--glow) 45%, transparent);
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".work-filter",
  );
  const rows = document.querySelectorAll<HTMLDivElement>(".work-row");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      filterButtons.forEach((b) => {
        b.classList.remove("is-active", "bg-cyan", "text-void");
        b.classList.add("glass-panel", "text-ink-muted");
      });
      button.classList.add("is-active", "bg-cyan", "text-void");
      button.classList.remove("glass-panel", "text-ink-muted");

      const filter = button.dataset.filter;
      rows.forEach((row) => {
        const show = filter === "All" || row.dataset.category === filter;
        row.classList.toggle("hidden", !show);
      });
    });
  });

  const canHover = window.matchMedia("(hover: hover)").matches;
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (canHover && !reduceMotion) {
    document.querySelectorAll<HTMLElement>(".tilt-card").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${(-py * 8).toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg) translateY(-4px)`;
      });
      card.addEventListener("pointerleave", () => {
        card.style.transform = "";
      });
    });
  }
</script>
