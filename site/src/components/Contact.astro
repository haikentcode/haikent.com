---
import SectionMark from "./SectionMark.astro";

const info = [
  {
    label: "Location",
    value: "Sector 27, Gurugram, India",
    color: "var(--color-cyan)",
    icon: "M12 21s-7-5.686-7-11a7 7 0 1 1 14 0c0 5.314-7 11-7 11Zm0-9a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z",
  },
  {
    label: "Channel",
    value: "haikenthk@gmail.com",
    href: "mailto:haikenthk@gmail.com",
    color: "var(--color-violet)",
    icon: "M3 6h18v12H3V6Zm0 0 9 7 9-7",
  },
  {
    label: "Frequency",
    value: "+91-82090568**",
    color: "var(--color-amber)",
    icon: "M4 5c0 8 7 15 15 15l3-4-6-3-2 2c-2-1-4-3-5-5l2-2-3-6-4 3Z",
  },
];
---

<section class="relative mx-auto flex min-h-screen max-w-[820px] flex-col justify-center px-6 py-24">
  <SectionMark
    label="Transmission"
    eyebrow="CONTACT"
    id="contact"
    color="var(--color-rose)"
  />

  <div class="grid gap-4 sm:grid-cols-3">
    {
      info.map((item) => (
        <div class="reveal glass-panel rounded-3xl p-5">
          <span
            class="grid h-10 w-10 place-items-center rounded-xl"
            style={`background-color: color-mix(in srgb, ${item.color} 15%, transparent); color: ${item.color}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d={item.icon} />
            </svg>
          </span>
          <p class="mt-3 font-mono text-[0.65rem] tracking-wide text-ink-muted">
            {item.label}
          </p>
          {item.href ? (
            <a href={item.href} class="text-sm font-medium text-ink hover:text-cyan">
              {item.value}
            </a>
          ) : (
            <p class="text-sm font-medium text-ink">{item.value}</p>
          )}
        </div>
      ))
    }
  </div>

  <form
    id="contact-form"
    action="/contact.php"
    method="post"
    class="reveal glass-panel mt-6 rounded-3xl p-6 sm:p-8"
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="name" class="sr-only">Your name</label>
        <input
          type="text"
          name="name"
          id="name"
          required
          minlength="4"
          placeholder="Your name"
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus-visible:border-cyan focus-visible:outline-none"
        />
      </div>
      <div>
        <label for="email" class="sr-only">Your email</label>
        <input
          type="email"
          name="email"
          id="email"
          required
          placeholder="Your email"
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus-visible:border-cyan focus-visible:outline-none"
        />
      </div>
    </div>
    <div class="mt-4">
      <label for="subject" class="sr-only">Subject</label>
      <input
        type="text"
        name="subject"
        id="subject"
        required
        minlength="4"
        placeholder="Subject"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus-visible:border-cyan focus-visible:outline-none"
      />
    </div>
    <div class="mt-4">
      <label for="message" class="sr-only">Message</label>
      <textarea
        name="message"
        id="message"
        rows="5"
        required
        placeholder="Message"
        class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus-visible:border-cyan focus-visible:outline-none"
      ></textarea>
    </div>

    <div class="mt-5 flex items-center gap-4">
      <button
        type="submit"
        data-magnetic
        data-cursor="SEND"
        class="rounded-full bg-gradient-to-r from-cyan to-violet px-6 py-2.5 text-sm font-semibold text-void shadow-[0_0_25px_rgba(34,211,238,0.3)] transition-transform hover:-translate-y-0.5"
      >
        Send transmission
      </button>
      <p
        id="contact-status"
        class="font-mono text-xs text-ink-muted"
        role="status"
        aria-live="polite"
      >
      </p>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    status.textContent = "Transmitting…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
      });
      status.textContent = response.ok
        ? "Message sent. Thank you!"
        : "Transmission failed — please email me directly instead.";
      if (response.ok) form.reset();
    } catch {
      status.textContent = "Transmission failed — please email me directly instead.";
    }
  });
</script>
