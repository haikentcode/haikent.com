---
import SectionMark from "./SectionMark.astro";
---

<section class="pb-16 sm:pb-20">
  <SectionMark label="Contact" id="contact" />

  <div class="flex flex-wrap gap-x-10 gap-y-2 text-sm text-ink-muted">
    <span>Sector 27, Gurugram, India</span>
    <a href="mailto:haikenthk@gmail.com" class="hover:text-ink">
      haikenthk@gmail.com
    </a>
    <span>+91-82090568**</span>
  </div>

  <form
    id="contact-form"
    action="/contact.php"
    method="post"
    class="mt-8 max-w-[560px] space-y-4"
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="name" class="sr-only">Your name</label>
        <input
          type="text"
          name="name"
          id="name"
          required
          minlength="4"
          placeholder="Your name"
          class="w-full border-b border-spine bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted focus-visible:border-teal focus-visible:outline-none"
        />
      </div>
      <div>
        <label for="email" class="sr-only">Your email</label>
        <input
          type="email"
          name="email"
          id="email"
          required
          placeholder="Your email"
          class="w-full border-b border-spine bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted focus-visible:border-teal focus-visible:outline-none"
        />
      </div>
    </div>
    <div>
      <label for="subject" class="sr-only">Subject</label>
      <input
        type="text"
        name="subject"
        id="subject"
        required
        minlength="4"
        placeholder="Subject"
        class="w-full border-b border-spine bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted focus-visible:border-teal focus-visible:outline-none"
      />
    </div>
    <div>
      <label for="message" class="sr-only">Message</label>
      <textarea
        name="message"
        id="message"
        rows="5"
        required
        placeholder="Message"
        class="w-full resize-none border-b border-spine bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted focus-visible:border-teal focus-visible:outline-none"
      ></textarea>
    </div>

    <div class="flex items-center gap-4 pt-1">
      <button
        type="submit"
        class="border border-ink px-5 py-2 text-sm text-ink transition-colors hover:bg-ink hover:text-paper"
      >
        Send message
      </button>
      <p
        id="contact-status"
        class="text-sm text-ink-muted"
        role="status"
        aria-live="polite"
      >
      </p>
    </div>
  </form>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    status.textContent = "Sending…";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
      });
      status.textContent = response.ok
        ? "Message sent. Thank you!"
        : "Something went wrong — please email me directly instead.";
      if (response.ok) form.reset();
    } catch {
      status.textContent = "Something went wrong — please email me directly instead.";
    }
  });
</script>
